{
  "name": "botix-ca",
  "version": "0.6.0",
  "private": true,
  "scripts": {
    "dev": "next dev --hostname 127.0.0.1",
    "build": "next build",
    "start": "next start --hostname 127.0.0.1",
    "lint": "eslint .",
    "typecheck": "tsc --noEmit",
    "test": "tsx --test tests/*.test.ts",
    "format": "prettier --write src tests",
    "catalog:check": "tsx scripts/catalog-check.ts",
    "delivery:check": "tsx scripts/check-readiness.ts",
    "delivery:test": "tsx scripts/test-delivery.ts",
    "release:smoke": "node scripts/release-smoke.mjs",
    "build:release": "node scripts/build-release.mjs",
    "package:release": "node scripts/package-standalone.mjs",
    "standalone:smoke": "BOTIX_STANDALONE=true node scripts/release-smoke.mjs",
    "staging:acceptance": "node scripts/staging-acceptance.mjs",
    "archive:staging": "node scripts/archive-staging.mjs"
  },
  "dependencies": {
    "next": "16.4.2",
    "react": "19.3.1",
    "react-dom": "19.3.1",
    "zod": "4.6.7"
  },
  "devDependencies": {
    "@tailwindcss/postcss": "4.3.3",
    "@types/node": "26.6.5",
    "@types/react": "19.3.0",
    "@types/react-dom": "19.3.0",
    "eslint": "9.39.5",
    "eslint-config-next": "16.4.2",
    "prettier": "3.9.10",
    "tailwindcss": "4.3.3",
    "tsx": "4.23.15",
    "typescript": "5.9.3"
  },
  "engines": {
    "node": ">=20.9.0"
  },
  "packageManager": "pnpm@11.25.0"
}
