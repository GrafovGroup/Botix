# Required values must be supplied by the operator/WHC secret manager.
# This is not a shell command and is not automatically loaded by start.cjs.
SITE_ENV=preview
SITE_URL=
PREVIEW_ACCESS_SECRET=
INQUIRY_DELIVERY_ENABLED=false
INQUIRY_RECEIVER_VERIFIED=false
INQUIRY_EDGE_RATE_LIMIT_CONFIRMED=false
TRUST_PROXY=false
HOSTNAME=127.0.0.1
PORT=3000
NODE_ENV=production
NEXT_TELEMETRY_DISABLED=1
# Phone verification and HSTS are disabled at build time in the 1E recipe.
