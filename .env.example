SITE_URL=https://botix.ca
# HTTPS delivery endpoint: respond with 2xx only after durable acceptance.
INQUIRY_WEBHOOK_URL=
INQUIRY_WEBHOOK_SECRET=
# Stable random secret (32+ bytes); required across replicas/restarts.
INQUIRY_SIGNING_SECRET=
# Enable only behind a proxy that overwrites X-Forwarded-For.
TRUST_PROXY=false
# Explicit opt-in after owner approval; default blocks all external delivery.
INQUIRY_DELIVERY_ENABLED=false
# Production attestations, set only after the actual controls are verified.
INQUIRY_RECEIVER_VERIFIED=false
INQUIRY_EDGE_RATE_LIMIT_CONFIRMED=false
# Public build-time values. Keep false until ownership/routing is verified.
NEXT_PUBLIC_PHONE_VERIFIED=false
NEXT_PUBLIC_PHONE_NUMBER=+18336969996
# Runtime site mode: development, preview, production. Production delivery requires production.
SITE_ENV=development
# Preview only: random 32+ byte shared password, Basic username botix. HTTPS required off loopback.
PREVIEW_ACCESS_SECRET=
# Build-time: enable only after HTTPS is enforced for every public request.
ENABLE_HSTS=false
